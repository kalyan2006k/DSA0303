import random
text = "I love python because python is easy and python is powerful"
words = text.split()
bigrams = {}
for i in range(len(words) - 1):
    bigrams.setdefault(words[i], []).append(words[i + 1])
word = "I"
result = [word]
for _ in range(10):
    if word in bigrams:
        word = random.choice(bigrams[word])
        result.append(word)
    else:
        break
print("Generated Text:")
print(" ".join(result))
