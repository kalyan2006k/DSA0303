from collections import Counter
import re

corpus = """Students will individually or in pairs write a Python program
to read a small text corpus and tokenize the text into words.
They will generate unigram and bigram frequency counts,
compute probabilities, and check for unseen bigrams."""

tokens = re.findall(r'\b\w+\b', corpus.lower())

tokens = ["<START>"] + tokens + ["<END>"]

unigram_counts = Counter(tokens)
total_unigrams = sum(unigram_counts.values())
unigram_probs = {word: count / total_unigrams for word, count in unigram_counts.items()}

bigram_counts = Counter(zip(tokens, tokens[1:]))
bigram_probs = {}
for (w1, w2), count in bigram_counts.items():
    bigram_probs[(w1, w2)] = count / unigram_counts[w1]

def check_bigram(w1, w2):
    if (w1, w2) in bigram_probs:
        return f"P({w2}|{w1}) = {bigram_probs[(w1, w2)]:.4f}"
    else:
        return f"P({w2}|{w1}) = 0 (unseen bigram)"

print("Unigram probabilities:")
for w, p in unigram_probs.items():
    print(f"{w}: {p:.4f}")

print("\nBigram probabilities:")
for (w1, w2), p in bigram_probs.items():
    print(f"{w1} {w2}: {p:.4f}")

print("\nCheck specific bigrams:")
print(check_bigram("students", "will"))
print(check_bigram("python", "rocks"))
print(check_bigram("bigrams", "<END>"))
print(check_bigram("<START>", "students"))
