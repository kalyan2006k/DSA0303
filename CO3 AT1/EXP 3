# Experiment 3
# Probabilistic Context-Free Grammar (PCFG) Parsing

# PCFG grammar probabilities

grammar = {
    "S": {
        ("NP", "VP"): 1.0
    },

    "NP": {
        ("John",): 0.6,
        ("Mary",): 0.4
    },

    "VP": {
        ("runs",): 0.5,
        ("walks",): 0.5
    }
}


def sentence_probability(sentence):
    """
    Parse a two-word sentence using the PCFG
    and calculate its probability.
    """

    words = sentence.strip().split()

    # Sentence must contain exactly two words
    if len(words) != 2:
        return 0.0

    subject = words[0]
    verb = words[1]

    # Check whether subject can be generated by NP
    np_probability = grammar["NP"].get(
        (subject,), 0.0
    )

    # Check whether verb can be generated by VP
    vp_probability = grammar["VP"].get(
        (verb,), 0.0
    )

    # If either word cannot be generated,
    # sentence probability is zero.
    if np_probability == 0.0 or vp_probability == 0.0:
        return 0.0

    # S -> NP VP has probability 1.0
    s_probability = grammar["S"][("NP", "VP")]

    # Calculate total sentence probability
    probability = (
        s_probability
        * np_probability
        * vp_probability
    )

    return probability


# Test cases
test_sentences = [
    "John runs",
    "John walks",
    "Mary runs",
    "Mary walks",
    "Peter runs"
]


for sentence in test_sentences:

    probability = sentence_probability(sentence)

    print(
        f"{sentence:<15} "
        f"Probability = {probability:.2f}"
    )
